# Example environment values for contributor tooling.
#
# Copy the variable names into your local shell or an untracked `.env` file if
# your tooling loads one. Never commit real API keys or OAuth tokens.

# Required by `npm run stitch:mockups` when generating Google Stitch UI options.
STITCH_API_KEY=

# Alternative OAuth-based Stitch authentication. Use this pair only when API
# key authentication is not available in your environment.
STITCH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
